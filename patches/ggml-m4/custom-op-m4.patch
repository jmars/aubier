+// MISTRAL-SMALL-4-ONLY: the MLA absorption gemv as one named op (see ggml.h).  The shape is
+// fixed and asserted; there is no generality, no dispatch and no CPU path.  b must be laid
+// out exactly as the engine builds it (a view of the [128, 32, 1] q_b output with a 128-float
+// head stride), which the kernel reads byte-explicitly.
+struct ggml_tensor * ggml_m4_wkb(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b) {
+    GGML_ASSERT(a->type == GGML_TYPE_Q8_0);
+    GGML_ASSERT(a->ne[0] == 64 && a->ne[1] == 256 && a->ne[2] == 32 && a->ne[3] == 1);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->ne[0] == 64 && b->ne[1] == 32 && b->ne[2] == 1 && b->ne[3] == 1);
+    GGML_ASSERT(b->nb[1] == 512);   // 128-float head stride, the engine's q_nope view
+
+    const int64_t ne[4] = { 256, 32, 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    result->op     = GGML_OP_M4_WKB;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}
+
+// MISTRAL-SMALL-4-ONLY: the fused attention core as one named op (see ggml.h).  The shape is
+// fixed and asserted; there is no generality, no dispatch and no CPU path.  kcache is the
+// per-layer F16 [320, n_kv_max] KV cache (K = rows [0,320), V = rows [0,256)); q is the F32
+// Qcur [320, 32, 1] with a 320-float head stride; mask is the F32 causal mask [n_kv_max, 1].
+struct ggml_tensor * ggml_m4_kqkv(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * kcache,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * mask,
+        float                 kq_scale) {
+    GGML_ASSERT(kcache->type == GGML_TYPE_F16);
+    // the head geometry is pinned (Mistral Small 4); the KV width is DYNAMIC (H3-U6) — the
+    // kernel is a tile loop whose bound is kcache->ne[1], so a wide cache (e.g. full-corpus
+    // scoring at kv-max 2501, or a future 256k context) is honoured, not silently sliced.
+    GGML_ASSERT(kcache->ne[0] == 320 && kcache->ne[1] >= 1 && kcache->ne[2] == 1 && kcache->ne[3] == 1);
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(q->ne[0] == 320 && q->ne[1] == 32 && q->ne[2] == 1 && q->ne[3] == 1);
+    GGML_ASSERT(mask->type == GGML_TYPE_F32);
+    GGML_ASSERT(mask->ne[0] == kcache->ne[1] && mask->ne[1] == 1 && mask->ne[2] == 1 && mask->ne[3] == 1);
+
+    // [256, 1, 32, 1]: d fastest (256), then the token batch (1), then the heads (32) — the
+    // SAME ne[] layout as the reference g_kqv (mul_mat(vT, softmax(kq))), which the downstream
+    // attn_v_b mul_mat keys its head dim off (ne[2] == 32 == the weight's ne[2]).
+    const int64_t ne[4] = { 256, 1, 32, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    ggml_set_op_params_f32(result, 0, kq_scale);
+
+    result->op     = GGML_OP_M4_KQKV;
+    result->src[0] = kcache;
+    result->src[1] = q;
+    result->src[2] = mask;
+
+    return result;
+}
+
+// MISTRAL-SMALL-4-ONLY: the attention chain's remaining per-token PHASE fusions, one op
+// (GGML_OP_M4_PHASE) with op_params[0] selecting the phase.  Fixed shapes, asserted here and
+// re-asserted in the launcher; there is no dispatch, no fallback and no CPU path.
+// op_params INT32 INDICES (ggml_set_op_params_* index an int32 array, they are NOT byte
+// offsets — a byte offset here silently writes past op_params and corrupts src[] in a
+// Release build, where the bounds assert is compiled out): 0 = phase (i32), 1..6 = freq_base,
+// freq_scale, ext_factor, attn_factor, beta_fast, beta_slow (f32), 7 = eps (f32),
+// 8 = n_dims (i32), 9 = n_ctx_orig (i32).
+struct ggml_tensor * ggml_m4_phase_kvwrite(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * cur,
+        struct ggml_tensor  * wkv_a,
+        struct ggml_tensor  * kvn,
+        struct ggml_tensor  * kcache,
+        struct ggml_tensor  * kidx,
+        struct ggml_tensor  * pos,
+        float                 freq_base,
+        float                 freq_scale,
+        float                 ext_factor,
+        float                 attn_factor,
+        float                 beta_fast,
+        float                 beta_slow,
+        float                 eps,
+        int                   n_dims,
+        int                   n_ctx_orig) {
+    GGML_ASSERT(cur->type == GGML_TYPE_F32);
+    GGML_ASSERT(cur->ne[0] == 4096 && cur->ne[1] == 1 && cur->ne[2] == 1 && cur->ne[3] == 1);
+    GGML_ASSERT(wkv_a->type == GGML_TYPE_Q8_0);
+    GGML_ASSERT(wkv_a->ne[0] == 4096 && wkv_a->ne[1] == 320 && wkv_a->ne[2] == 1 && wkv_a->ne[3] == 1);
+    GGML_ASSERT(kvn->type == GGML_TYPE_F32 && kvn->ne[0] == 256);
+    GGML_ASSERT(kcache->type == GGML_TYPE_F16);
+    GGML_ASSERT(kcache->ne[0] == 320 && kcache->ne[2] == 1 && kcache->ne[3] == 1);
+    GGML_ASSERT(kidx->type == GGML_TYPE_I64 && kidx->ne[0] == 1);
+    GGML_ASSERT(pos->type == GGML_TYPE_I32 && pos->ne[0] == 1);
+
+    const int64_t ne[4] = { 320, 1, 1, 1 };   // Kcur: the row the cache received
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+    result->op     = GGML_OP_M4_PHASE;
+    result->src[0] = cur;
+    result->src[1] = wkv_a;
+    result->src[2] = kvn;
+    result->src[3] = kcache;
+    result->src[4] = kidx;
+    result->src[5] = pos;
+
+    ggml_set_op_params_i32(result, 0, 0);               // M4_PHASE_KVWRITE
+    ggml_set_op_params_f32(result, 1, freq_base);
+    ggml_set_op_params_f32(result, 2, freq_scale);
+    ggml_set_op_params_f32(result, 3, ext_factor);
+    ggml_set_op_params_f32(result, 4, attn_factor);
+    ggml_set_op_params_f32(result, 5, beta_fast);
+    ggml_set_op_params_f32(result, 6, beta_slow);
+    ggml_set_op_params_f32(result, 7, eps);
+    ggml_set_op_params_i32(result, 8, n_dims);
+    ggml_set_op_params_i32(result, 9, n_ctx_orig);
+
+    return result;
+}
+
+struct ggml_tensor * ggml_m4_phase_wvb(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * wv_b,
+        struct ggml_tensor  * x) {
+    GGML_ASSERT(wv_b->type == GGML_TYPE_Q8_0);
+    GGML_ASSERT(wv_b->ne[0] == 256 && wv_b->ne[1] == 128 && wv_b->ne[2] == 32 && wv_b->ne[3] == 1);
+    GGML_ASSERT(x->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[0] == 256 && x->ne[1] == 1 && x->ne[2] == 32 && x->ne[3] == 1);
+
+    // [128, 1, 32]: the SAME ne[] layout the reference mul_mat(wv_b, g_kqv) produces, which the
+    // downstream head-recombination reshape_2d keys off.
+    const int64_t ne[4] = { 128, 1, 32, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+    result->op     = GGML_OP_M4_PHASE;
+    result->src[0] = wv_b;
+    result->src[1] = x;
+
+    ggml_set_op_params_i32(result, 0, 1);               // M4_PHASE_WVB
+    return result;
+}
+
 // ggml_mul_mat_id
 
