diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 957908f65..b515fa5cf 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5362,6 +5362,16 @@ static ggml_backend_buffer_type_t ggml_backend_cuda_device_get_host_buffer_type(
     return ggml_backend_cuda_host_buffer_type();
 }
 
+// [P-A] cached env-flag read: GGML_CUDA_MOE_F32_SRC=1 lets MUL_MAT_ID ops whose
+// src1 must stay F32 be placed on the GPU (see the call site in supports_op).
+static bool ggml_cuda_moe_f32_src_enabled() {
+    static const bool enabled = [] {
+        const char * env = getenv("GGML_CUDA_MOE_F32_SRC");
+        return env != nullptr && env[0] == '1';
+    }();
+    return enabled;
+}
+
 // TODO: move these functions here
 static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const ggml_tensor * op) {
     ggml_backend_cuda_device_context * dev_ctx = (ggml_backend_cuda_device_context *) dev->context;
@@ -5438,7 +5448,15 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
                 if (b->type == GGML_TYPE_F16 && a->type != GGML_TYPE_F16 && !ggml_cuda_op_mul_mat_use_fwht(op)) {
                     return false;
                 }
-                if (op->op == GGML_OP_MUL_MAT_ID && ggml_get_op_params_i32(op, 3) == GGML_PREC_F32) {
+                // [P-A] MUL_MAT_ID with F32 src1 precision (op_params[3]) is normally
+                // rejected here, so a MoE down-projection whose src1 must stay F32 (e.g.
+                // mistral4: the swiglu output can exceed F16 range) is placed on CPU even
+                // when its expert weights are GPU-resident -> per-token D2H weight copies.
+                // The dispatch in ggml_cuda_mul_mat_id() DOES handle F32 src1 via
+                // ggml_cuda_mul_mat_vec_q() (which asserts src1->type == F32), so the
+                // rejection is over-conservative. Gate the rejection off behind an env
+                // flag so the fix is A/B-able and inert when the flag is unset.
+                if (op->op == GGML_OP_MUL_MAT_ID && ggml_get_op_params_i32(op, 3) == GGML_PREC_F32 && !ggml_cuda_moe_f32_src_enabled()) {
                     return false;
                 }
 #ifdef GGML_USE_MUSA
